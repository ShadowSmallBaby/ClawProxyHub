# ClawProxyHub 环境变量示例
# 复制为 .env 或直接 export，全部可选（未设置走默认值），除 CPH_ADMIN_PASSWORD 外

# ---------- 管理后台 ----------

# 管理员引导：仅首次启动（users 表为空）时用于自动建号，之后以数据库为准
# 不设置则首次启动时在网页 /setup 引导页创建（可自定义用户名）
# export CPH_ADMIN_USERNAME='admin'
# export CPH_ADMIN_PASSWORD='change-me'

# 首次启动引导的调用密钥（可选；之后在仪表盘「密钥」页自行创建）
# export CPH_SEED_API_KEY='cph-xxxx'

# ---------- 服务 ----------

# HTTP 监听地址
# export CPH_ADDR=':8080'

# 数据目录（数据库、插件都在其下）
# 显式相对路径以启动目录为基准；省略数据库、插件等路径时从 CPH_DATA_DIR 自动推导
# export CPH_DATA_DIR='data'

# 已签名 .cphext/.cphhost 的挂载目录；默认 <CPH_DATA_DIR>/packages
# 多个目录在 Linux/macOS 用冒号分隔，Windows 用分号分隔
# export CPH_PACKAGE_DIRS='packages'

# 首次自动安装可信挂载包，默认开启；false 时仍可从扩展中心手动安装
# 不影响已有安装、停用或卸载状态；命令行 --install-packages=false 可覆盖
# export CPH_INSTALL_PACKAGES=true

# 额外的扩展签名信任配置；默认 <CPH_DATA_DIR>/extensions-trust.json
# export CPH_EXTENSION_TRUST='extensions-trust.json'

# ---------- 存储 ----------

# SQLite 路径；留空用 <CPH_DATA_DIR>/cph.db
# export CPH_DATABASE_DSN='cph.db'

# ---------- 插件 ----------

# 插件安装目录；留空用 <CPH_DATA_DIR>/plugins
# 显式设置时相对启动目录解析
# export CPH_PLUGIN_DIR='plugins'

# 插件市场索引（ClawProxyHubPlugins 仓库的 index.json；仪表盘「设置」里的自建地址优先）
# export CPH_MARKETPLACE_URL='https://raw.githubusercontent.com/ShadowSmallBaby/ClawProxyHubPlugins/main/index.json'

# ---------- 进程通信（core ↔ 插件 gRPC）----------

# core 与插件子进程间 gRPC 单条消息字节上限；默认 67108864（64MB）。
# gRPC 原生默认仅 4MB，长会话请求会 502（ResourceExhausted: received message larger than max）。
# 支持纯字节整数或带单位（大小写不敏感、1024 进制）：64mb / 64MB / 64m / 4096kb / 67108864 均可。
# 核心与插件读同一变量保持两端一致；非法或低于 4MB 回退默认。
# 改后需重启（插件子进程随核心重启继承新值；本变量属 SDK 逻辑，插件须重编才会读取）。
# export CPH_GRPC_MAX_MSG_SIZE=64mb
