# ClawProxyHub 环境变量示例
# 复制为 .env 或直接 export，全部可选（未设置走默认值），除 CPH_ADMIN_PASSWORD 外

# ---------- 管理后台 ----------

# 管理员引导：仅首次启动（users 表为空）时用于自动建号，之后以数据库为准
# 不设置则首次启动时在网页 /setup 引导页创建（可自定义用户名）
# export CPH_ADMIN_USERNAME='admin'
# export CPH_ADMIN_PASSWORD='change-me'

# 首次启动引导的调用密钥（可选；之后在仪表盘「密钥」页自行创建）
# export CPH_SEED_API_KEY='cph-xxxx'

# ---------- 服务 ----------

# HTTP 监听地址
# export CPH_ADDR=':8080'

# 数据目录（数据库、插件都在其下）
# export CPH_DATA_DIR='./data'

# ---------- 存储 ----------

# SQLite 路径；留空用 <CPH_DATA_DIR>/cph.db
# export CPH_DATABASE_DSN='./data/cph.db'

# ---------- 插件 ----------

# 插件安装目录；留空用 <CPH_DATA_DIR>/plugins
# export CPH_PLUGIN_DIR='./data/plugins'

# 插件市场索引（ClawProxyHubPlugins 仓库的 index.json；仪表盘「设置」里的自建地址优先）
# export CPH_MARKETPLACE_URL='https://raw.githubusercontent.com/ShadowSmallBaby/ClawProxyHubPlugins/main/index.json'
